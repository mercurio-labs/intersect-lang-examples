grammar org.intersect.examples.Petri with org.eclipse.xtext.common.Terminals
import "urn:intersect:example:petri:1" as p
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

Net returns p::Net:
  'net' name=ID '{' (places+=Place | transitions+=Transition)* '}';

Place returns p::Place:
  'place' name=ID ('=' tokens=INT)?;

Transition returns p::Transition:
  'transition' name=ID (external?='external')? (delay=Delay)?
  ':' (inputs+=Arc (',' inputs+=Arc)*)? '->' (outputs+=Arc (',' outputs+=Arc)*)?;

Arc returns p::Arc:
  (weight=INT '*')? place=[p::Place];

Delay returns p::Delay:
  'after' amount=INT unit=TimeUnit;

TimeUnit returns ecore::EString:
  'ms' | 's';
