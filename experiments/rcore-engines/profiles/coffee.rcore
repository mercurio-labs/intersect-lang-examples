rcore 1;
package experiment.coffee version "1";

pub fn engine() -> String = "intersect.timed-token-flow@1";

pub fn settings() -> {policy: String, seed: Int, until: Int} =
  {policy: "first", seed: 0, until: 20000};

pub fn net() -> {
  name: String,
  places: Sequence<{id: String, name: String, tokens: Int}>,
  transitions: Sequence<{id: String, name: String, external: Bool, delay_ms: Int,
    inputs: Sequence<{place: String, weight: Int}>,
    outputs: Sequence<{place: String, weight: Int}>}>
} = {
  name: "CoffeeMachine",
  places: [
    {id: "coffee.petri#1", name: "idle", tokens: 1},
    {id: "coffee.petri#2", name: "coins", tokens: 0},
    {id: "coffee.petri#3", name: "brewing", tokens: 0},
    {id: "coffee.petri#4", name: "cups", tokens: 0}
  ],
  transitions: [
    {id: "coffee.petri#5", name: "insert", external: true, delay_ms: 0,
     inputs: [], outputs: [{place: "coffee.petri#2", weight: 1}]},
    {id: "coffee.petri#7", name: "start", external: false, delay_ms: 0,
     inputs: [{place: "coffee.petri#1", weight: 1}, {place: "coffee.petri#2", weight: 1}], outputs: [{place: "coffee.petri#3", weight: 1}]},
    {id: "coffee.petri#11", name: "brew", external: false, delay_ms: 3000,
     inputs: [{place: "coffee.petri#3", weight: 1}], outputs: [{place: "coffee.petri#1", weight: 1}, {place: "coffee.petri#4", weight: 1}]}
  ]
};

pub fn scenario() -> {inputs: Sequence<{at_ms: Int, transition: String}>} =
  {inputs: [{at_ms: 0, transition: "insert"}, {at_ms: 1000, transition: "insert"}]};
